{
	"info": {
		"_postman_id": "push-notification-sys-collection-v1",
		"name": "Push Notification System - API Collection (Step-by-Step)",
		"description": "Complete Postman Collection covering all endpoints in sequential execution order: IAM/Auth -> Organization & Apps -> Provider Credentials -> API Keys -> Client SDK Device Registration -> Dynamic Segments -> Dispatch Notifications -> Telemetry Ingest -> Analytics & Delivery Logs.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080",
			"type": "string"
		},
		{
			"key": "accessToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "orgId",
			"value": "cccccccc-cccc-cccc-cccc-cccccccccccc",
			"type": "string"
		},
		{
			"key": "appId",
			"value": "11111111-2222-3333-4444-555555555551",
			"type": "string"
		},
		{
			"key": "serverApiKey",
			"value": "os_live_demo1234567890abcdef1234567890",
			"type": "string"
		},
		{
			"key": "sdkKey",
			"value": "os_pub_demo9876543210abcdef9876543210",
			"type": "string"
		},
		{
			"key": "apiKeyId",
			"value": "",
			"type": "string"
		},
		{
			"key": "segmentId",
			"value": "",
			"type": "string"
		},
		{
			"key": "notificationId",
			"value": "",
			"type": "string"
		},
		{
			"key": "pushToken",
			"value": "fcm_dummy_registration_token_step_4_abc123",
			"type": "string"
		},
		{
			"key": "deviceId",
			"value": "device_user_vip_001",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Step 1: Authentication & IAM",
			"item": [
				{
					"name": "1.1 Login (Admin / Demo)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.accessToken) {",
									"    pm.collectionVariables.set('accessToken', jsonData.accessToken);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin@pushnotify.local\",\n  \"password\": \"Password123!\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/admin/api/v1/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["admin", "api", "v1", "auth", "login"]
						},
						"description": "Authenticates and automatically sets `accessToken` collection variable."
					}
				},
				{
					"name": "1.2 Refresh Access Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.accessToken) {",
									"    pm.collectionVariables.set('accessToken', jsonData.accessToken);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/admin/api/v1/auth/refresh",
							"host": ["{{baseUrl}}"],
							"path": ["admin", "api", "v1", "auth", "refresh"]
						},
						"description": "Exchanges httpOnly `push_refresh_token` cookie for a fresh access token."
					}
				},
				{
					"name": "1.3 Verify MFA (Optional)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"mfaToken\": \"temp_mfa_token_here\",\n  \"code\": \"123456\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/admin/api/v1/auth/mfa/verify",
							"host": ["{{baseUrl}}"],
							"path": ["admin", "api", "v1", "auth", "mfa", "verify"]
						}
					}
				},
				{
					"name": "1.4 Get Current User (Me)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/admin/api/v1/auth/me",
							"host": ["{{baseUrl}}"],
							"path": ["admin", "api", "v1", "auth", "me"]
						}
					}
				},
				{
					"name": "1.5 List User Organizations",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/admin/api/v1/organizations",
							"host": ["{{baseUrl}}"],
							"path": ["admin", "api", "v1", "organizations"]
						}
					}
				},
				{
					"name": "1.6 Create Organization",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.id) {",
									"    pm.collectionVariables.set('orgId', jsonData.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Acme Global Corp\",\n  \"slug\": \"acme-global\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/admin/api/v1/organizations",
							"host": ["{{baseUrl}}"],
							"path": ["admin", "api", "v1", "organizations"]
						}
					}
				},
				{
					"name": "1.7 List Org Members",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/admin/api/v1/organizations/{{orgId}}/members",
							"host": ["{{baseUrl}}"],
							"path": ["admin", "api", "v1", "organizations", "{{orgId}}", "members"]
						}
					}
				},
				{
					"name": "1.8 Invite Member to Org",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"developer@example.com\",\n  \"roleId\": \"DEVELOPER\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/admin/api/v1/organizations/{{orgId}}/members/invite",
							"host": ["{{baseUrl}}"],
							"path": ["admin", "api", "v1", "organizations", "{{orgId}}", "members", "invite"]
						}
					}
				},
				{
					"name": "1.9 Accept Invitation",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"token\": \"invitation_token_string\",\n  \"password\": \"SecurePass123!\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/admin/api/v1/invitations/accept",
							"host": ["{{baseUrl}}"],
							"path": ["admin", "api", "v1", "invitations", "accept"]
						}
					}
				},
				{
					"name": "1.10 Logout",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/admin/api/v1/auth/logout",
							"host": ["{{baseUrl}}"],
							"path": ["admin", "api", "v1", "auth", "logout"]
						}
					}
				}
			]
		},
		{
			"name": "Step 2: Apps & Provider Credentials",
			"item": [
				{
					"name": "2.1 List Apps in Org",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/admin/api/v1/organizations/{{orgId}}/apps",
							"host": ["{{baseUrl}}"],
							"path": ["admin", "api", "v1", "organizations", "{{orgId}}", "apps"]
						}
					}
				},
				{
					"name": "2.2 Create New App",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.id) {",
									"    pm.collectionVariables.set('appId', jsonData.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Mobile E-Commerce App\",\n  \"description\": \"Primary mobile storefront app for Android and iOS\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/admin/api/v1/organizations/{{orgId}}/apps",
							"host": ["{{baseUrl}}"],
							"path": ["admin", "api", "v1", "organizations", "{{orgId}}", "apps"]
						}
					}
				},
				{
					"name": "2.3 Get App Details",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/admin/api/v1/apps/{{appId}}",
							"host": ["{{baseUrl}}"],
							"path": ["admin", "api", "v1", "apps", "{{appId}}"]
						}
					}
				},
				{
					"name": "2.4 List App Credentials",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/admin/api/v1/apps/{{appId}}/credentials",
							"host": ["{{baseUrl}}"],
							"path": ["admin", "api", "v1", "apps", "{{appId}}", "credentials"]
						}
					}
				},
				{
					"name": "2.5 Save FCM / APNS Provider Credential",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"providerType\": \"FCM\",\n  \"rawCredential\": \"{\\\"type\\\":\\\"service_account\\\",\\\"project_id\\\":\\\"push-project\\\",\\\"private_key\\\":\\\"-----BEGIN PRIVATE KEY-----\\\\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC6\\\\n-----END PRIVATE KEY-----\\\\n\\\",\\\"client_email\\\":\\\"firebase-adminsdk@push-project.iam.gserviceaccount.com\\\"}\",\n  \"metadata\": {\n    \"projectId\": \"push-project\"\n  }\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/admin/api/v1/apps/{{appId}}/credentials",
							"host": ["{{baseUrl}}"],
							"path": ["admin", "api", "v1", "apps", "{{appId}}", "credentials"]
						}
					}
				},
				{
					"name": "2.6 Test Provider Credential",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/admin/api/v1/apps/{{appId}}/credentials/FCM/test",
							"host": ["{{baseUrl}}"],
							"path": ["admin", "api", "v1", "apps", "{{appId}}", "credentials", "FCM", "test"]
						}
					}
				}
			]
		},
		{
			"name": "Step 3: API Keys Management",
			"item": [
				{
					"name": "3.1 List App API Keys",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/admin/api/v1/apps/{{appId}}/api-keys",
							"host": ["{{baseUrl}}"],
							"path": ["admin", "api", "v1", "apps", "{{appId}}", "api-keys"]
						}
					}
				},
				{
					"name": "3.2 Create Server REST API Key",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.id) {",
									"    pm.collectionVariables.set('apiKeyId', jsonData.id);",
									"}",
									"if (jsonData.rawKey) {",
									"    pm.collectionVariables.set('serverApiKey', jsonData.rawKey);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Backend Production Server Key\",\n  \"keyType\": \"SERVER_REST\",\n  \"scopes\": [\"NOTIFICATIONS_WRITE\", \"NOTIFICATIONS_READ\"]\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/admin/api/v1/apps/{{appId}}/api-keys",
							"host": ["{{baseUrl}}"],
							"path": ["admin", "api", "v1", "apps", "{{appId}}", "api-keys"]
						}
					}
				},
				{
					"name": "3.3 Create SDK Public Key",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.rawKey) {",
									"    pm.collectionVariables.set('sdkKey', jsonData.rawKey);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Android Client SDK Key\",\n  \"keyType\": \"SDK_PUBLIC\",\n  \"scopes\": [\"SDK_WRITE\"]\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/admin/api/v1/apps/{{appId}}/api-keys",
							"host": ["{{baseUrl}}"],
							"path": ["admin", "api", "v1", "apps", "{{appId}}", "api-keys"]
						}
					}
				},
				{
					"name": "3.4 Rotate API Key",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/admin/api/v1/apps/{{appId}}/api-keys/{{apiKeyId}}/rotate",
							"host": ["{{baseUrl}}"],
							"path": ["admin", "api", "v1", "apps", "{{appId}}", "api-keys", "{{apiKeyId}}", "rotate"]
						}
					}
				},
				{
					"name": "3.5 Revoke API Key",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/admin/api/v1/apps/{{appId}}/api-keys/{{apiKeyId}}",
							"host": ["{{baseUrl}}"],
							"path": ["admin", "api", "v1", "apps", "{{appId}}", "api-keys", "{{apiKeyId}}"]
						}
					}
				}
			]
		},
		{
			"name": "Step 4: Device Management (SDK & Admin)",
			"item": [
				{
					"name": "4.1 Register / Upsert Device (SDK)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "X-Sdk-Key",
								"value": "{{sdkKey}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"platform\": \"ANDROID\",\n  \"pushToken\": \"{{pushToken}}\",\n  \"externalUserId\": \"user_vip_1001\",\n  \"appVersion\": \"2.4.0\",\n  \"deviceModel\": \"Pixel 8 Pro\",\n  \"osVersion\": \"15.0\",\n  \"language\": \"en\",\n  \"timezone\": \"UTC+7\",\n  \"tags\": {\n    \"vip\": \"true\",\n    \"tier\": \"gold\",\n    \"location\": \"VN\"\n  }\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/sdk/v1/devices",
							"host": ["{{baseUrl}}"],
							"path": ["sdk", "v1", "devices"]
						}
					}
				},
				{
					"name": "4.2 Query Devices List (Admin)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/admin/api/v1/apps/{{appId}}/devices?page=0&size=20&platform=ANDROID&active=true",
							"host": ["{{baseUrl}}"],
							"path": ["admin", "api", "v1", "apps", "{{appId}}", "devices"],
							"query": [
								{ "key": "page", "value": "0" },
								{ "key": "size", "value": "20" },
								{ "key": "platform", "value": "ANDROID" },
								{ "key": "active", "value": "true" }
							]
						}
					}
				},
				{
					"name": "4.3 Deactivate Device Subscription (SDK)",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "X-Sdk-Key",
								"value": "{{sdkKey}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/sdk/v1/devices/{{pushToken}}",
							"host": ["{{baseUrl}}"],
							"path": ["sdk", "v1", "devices", "{{pushToken}}"]
						}
					}
				}
			]
		},
		{
			"name": "Step 5: Dynamic Segments",
			"item": [
				{
					"name": "5.1 List Segments",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/admin/api/v1/apps/{{appId}}/segments",
							"host": ["{{baseUrl}}"],
							"path": ["admin", "api", "v1", "apps", "{{appId}}", "segments"]
						}
					}
				},
				{
					"name": "5.2 Create Segment (VIP Android Users)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.id) {",
									"    pm.collectionVariables.set('segmentId', jsonData.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"VIP Android Users\",\n  \"filterAst\": {\n    \"conjunction\": \"AND\",\n    \"rules\": [\n      {\n        \"field\": \"platform\",\n        \"operator\": \"EQUALS\",\n        \"value\": \"ANDROID\"\n      },\n      {\n        \"field\": \"tags.vip\",\n        \"operator\": \"EQUALS\",\n        \"value\": \"true\"\n      }\n    ]\n  }\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/admin/api/v1/apps/{{appId}}/segments",
							"host": ["{{baseUrl}}"],
							"path": ["admin", "api", "v1", "apps", "{{appId}}", "segments"]
						}
					}
				},
				{
					"name": "5.3 Preview Segment Match Count",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/admin/api/v1/apps/{{appId}}/segments/{{segmentId}}/preview-count",
							"host": ["{{baseUrl}}"],
							"path": ["admin", "api", "v1", "apps", "{{appId}}", "segments", "{{segmentId}}", "preview-count"]
						}
					}
				}
			]
