# ==============================================================================
# Multi-Tenant Push Notification Engine - Environment Configuration Reference
# Copy this file to .env and customize values for your deployment environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server URLs & Network Ports
# ------------------------------------------------------------------------------
# Backend API Public URL (used for media URLs, avatars, webhooks, auth callbacks)
APP_BASE_URL=http://localhost:8080
BACKEND_PORT=8080

# Frontend Web Portal Public URL (used for CORS allowed origins & redirect links)
FRONTEND_URL=http://localhost:3001
FRONTEND_PORT=3001

# Vite / Nginx API Gateway routing
VITE_API_BASE_URL=/api
VITE_ENABLE_MOCK_DATA=false

# ------------------------------------------------------------------------------
# 2. Database (PostgreSQL 17)
# ------------------------------------------------------------------------------
DB_HOST=postgres
DB_PORT=5432
DB_NAME=push_platform
DB_USER=postgres
DB_PASSWORD=postgres_password
POSTGRES_PORT=54327

# ------------------------------------------------------------------------------
# 3. Cache & Rate Limiting (Redis 7)
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_PORT=6380

# ------------------------------------------------------------------------------
# 4. Distributed Event Streaming (Apache Kafka 3.7.0 KRaft)
# ------------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_PORT=9092

# ------------------------------------------------------------------------------
# 5. Media & Storage Configuration
# ------------------------------------------------------------------------------
UPLOAD_PROVIDER=local
UPLOAD_DIR=/app/uploads
UPLOAD_PUBLIC_PATH_PREFIX=/uploads
UPLOAD_CDN_BASE_URL=
AVATAR_MAX_DIMENSION=512
AVATAR_MAX_BYTES=5242880
AVATAR_JPEG_QUALITY=0.88
MIGRATE_BASE64_AVATARS=false

# ------------------------------------------------------------------------------
# 6. Security, Tokens & Cryptography
# ------------------------------------------------------------------------------
# HMAC-SHA256 Signing Secret for JWT Access and Refresh Tokens
JWT_SECRET=4z7x9w2v8y5k1m3p6r9t0q4s7u2w5x8z1a3c5e7g9i1k3m5o7q9s1u3w5y7z9a1b

# AES-256-GCM Master Key for Encrypting FCM/APNs Credentials in Database
CRYPTO_MASTER_KEY=k4P8q3Z1y7W2v9T0x5R8u1O3m6L9j2H5g7E0b3D6a8=

# ------------------------------------------------------------------------------
# 7. Mailgun Transactional Email Configuration
# ------------------------------------------------------------------------------
MAILGUN_ENABLED=false
MAILGUN_API_KEY=your_mailgun_api_key
MAILGUN_DOMAIN=your_mailgun_domain
MAILGUN_BASE_URL=https://api.mailgun.net/v3
MAILGUN_FROM_ADDRESS=Bronx Notification <postmaster@your_mailgun_domain>
MAILGUN_WEBHOOK_KEY=your_mailgun_webhook_signing_key

# ------------------------------------------------------------------------------
# 8. Container Runtime & JVM Optimization (Java 25 Alpine)
# ------------------------------------------------------------------------------
DOCKER_DEFAULT_PLATFORM=linux/arm64
BACKEND_IMAGE=push-backend:latest
FRONTEND_IMAGE=push-frontend:latest
JAVA_OPTS=-XX:+UseSerialGC -Xms128m -Xmx384m -XX:MaxMetaspaceSize=160m -XX:CompressedClassSpaceSize=48m -XX:+ExitOnOutOfMemoryError

# ==============================================================================
# 9. Remote Transfer & AWS Deployment Settings
# ==============================================================================
REMOTE_USER=ec2-user
REMOTE_HOST=44.236.xxx.xx
REMOTE_DIR=/var/www/html/notify
SSH_KEY=~/.ssh/id_rsa
SSH_PORT=22


