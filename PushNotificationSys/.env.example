# Multi-Tenant Push Notification Engine Environment Config
FRONTEND_PORT=3001
FRONTEND_URL=http://localhost:3001
BACKEND_PORT=8080
POSTGRES_PORT=54327
REDIS_PORT=6380
KAFKA_PORT=9092

# Mailgun Transactional Email Configuration (Replace with your Mailgun credentials)
MAILGUN_ENABLED=false
MAILGUN_API_KEY=your_mailgun_api_key
MAILGUN_DOMAIN=your_mailgun_domain
MAILGUN_BASE_URL=https://api.mailgun.net/v3
MAILGUN_FROM_ADDRESS=Bronx Notification <postmaster@your_mailgun_domain>
MAILGUN_WEBHOOK_KEY=your_mailgun_webhook_signing_key
